# Optional embedding API (OpenAI-compatible); keep secrets on the SSD in .env
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Optional chat model for the avatar (OpenAI-compatible /chat/completions).
# Without CHAT_URL the avatar answers locally from facts and notes.
CHAT_URL=
CHAT_API_KEY=
CHAT_MODEL=gpt-4o-mini
