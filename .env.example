# Copy to .env on your computer. Never commit .env.
# PostgreSQL: primary persistent storage. Leave empty to use local JSON.
DATABASE_URL=
PG_SSL=false

# Neo4j: Bolt driver; install Neo4j locally or use a trusted remote instance.
NEO4J_BOLT_URL=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Qdrant: REST API; embedding provider is required for semantic indexing.
QDRANT_URL=
QDRANT_API_KEY=
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
